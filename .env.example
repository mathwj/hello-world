# --- Analysis -------------------------------------------------------------
# Set ONE of these. Without a key the app still runs, but falls back to
# keyword-only scoring. OpenAI is used when both are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting from the keys: openai | anthropic
# LLM_PROVIDER=openai

# Model used for brief parsing and candidate analysis.
# OpenAI alternatives: gpt-5.6-sol, gpt-5.4, gpt-5.4-mini (cheaper/faster)
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort. The brief is parsed once, so it can afford "high";
# analysis runs once per candidate, so "medium" keeps a wide sweep affordable.
CRITERIA_EFFORT=high
ANALYSIS_EFFORT=medium

# Candidate analyses in flight at once.
ANALYSIS_CONCURRENCY=6

# --- Sources --------------------------------------------------------------
# Comma-separated adapter ids enabled by default: sample, csv, proxycurl, websearch
# `sample` is the bundled FICTIONAL demo dataset — switch this to use real data.
DEFAULT_SOURCES=sample

# Directory scanned by the `csv` adapter for .csv / .json profile exports.
IMPORT_DIR=data/imports

# Licensed LinkedIn-derived data provider. Required for the `proxycurl` adapter.
PROXYCURL_API_KEY=

# Search-engine discovery. Required for the `websearch` adapter.
SERPAPI_API_KEY=

# Politeness delay between outbound provider calls, in milliseconds.
SOURCE_REQUEST_DELAY_MS=250

# --- Limits ---------------------------------------------------------------
MAX_PROFILES=60
HARD_MAX_PROFILES=200
PORT=3000
