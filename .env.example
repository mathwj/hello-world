# --- Analysis -------------------------------------------------------------
# Set ONE of these. Without a key the app still runs, but falls back to
# keyword-only scoring. OpenAI is used when both are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting from the keys: openai | anthropic
# LLM_PROVIDER=openai

# Model used for brief parsing and candidate analysis.
# OpenAI alternatives: gpt-5.6-sol, gpt-5.4, gpt-5.4-mini (cheaper/faster)
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort. The brief is parsed once, so it can afford "high";
# analysis runs once per candidate, so "medium" keeps a wide sweep affordable.
CRITERIA_EFFORT=high
ANALYSIS_EFFORT=medium

# Candidate analyses in flight at once.
ANALYSIS_CONCURRENCY=6

# --- Sources --------------------------------------------------------------
# Comma-separated adapter ids enabled by default:
#   sample     bundled FICTIONAL demo profiles (default — switch this for real data)
#   csv        exports you already hold, from data/imports/
#   ninjapear  account-based vendor search (needs a key AND a company list)
#   websearch  public search discovery, names and headlines only
DEFAULT_SOURCES=sample

# Directory scanned by the `csv` adapter for .csv / .json profile exports.
IMPORT_DIR=data/imports

# NinjaPear (nubela.co). Its employee search is keyed on COMPANY WEBSITE, not
# on city, so it also needs a target company list — either inline below or one
# company per line in data/companies.txt (see data/companies.example.txt).
NINJAPEAR_API_KEY=
# NINJAPEAR_COMPANIES=acme.com.br,Another Company Name

# Role variants tried per company. The fan-out is companies x roles, so this
# multiplies your spend directly.
NINJAPEAR_MAX_ROLES=4

# Hard stop on estimated credits for a single run. Search costs 2 credits per
# company+role pair plus 1 per person returned; enrichment costs 3 per person,
# charged even on a miss. Start low.
NINJAPEAR_MAX_CREDITS=200

# Set to 0 to skip the 3-credit enrichment and get names and roles only.
# Cheap, but the analyst has no work history to reason about.
NINJAPEAR_ENRICH=1

# Proxycurl shut down in July 2025. Kept only for legacy access.
PROXYCURL_API_KEY=

# Search-engine discovery. Required for the `websearch` adapter.
SERPAPI_API_KEY=

# Politeness delay between outbound provider calls, in milliseconds.
SOURCE_REQUEST_DELAY_MS=250

# --- Limits ---------------------------------------------------------------
MAX_PROFILES=60
HARD_MAX_PROFILES=200
PORT=3000
